# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=

# The JSON from your Firebase Service Account (can be raw JSON or Base64 encoded)
FIREBASE_SERVICE_ACCOUNT_KEY=

# The JSON object from your Firebase Web App configuration
NEXT_PUBLIC_FIREBASE_CONFIG=

# Your Google Maps API key (restricted to your domain)
NEXT_PUBLIC_MAPS_API_KEY=

# Optional: Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# FCM Web Push VAPID key — find in Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FCM_VAPID_KEY=

# Set to false to use real Firebase/Gemini data, true for static demo data
NEXT_PUBLIC_DEMO_MODE=true

